    "react-native-worklets-core": "^1.6.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@formatjs/cli": "^6.16.33",
    "@types/react": "~19.2.2",
    "babel-plugin-formatjs": "^11.3.16",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "extract": "formatjs extract 'src/**/*.{ts,tsx}' --ignore 'src/**/*.d.ts' --out-file lang/en.json --id-interpolation-pattern '[sha512:contenthash:base64:6]'",
    "compile": "formatjs compile lang/en.json --ast --out-file src/i18n/compiled-lang/en.json",
    "compile-folder": "formatjs compile-folder --ast lang src/i18n/compiled-lang"
  },
  "private": true
